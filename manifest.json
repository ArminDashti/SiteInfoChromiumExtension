{
  "manifest_version": 3,
  "name": "Site Info",
  "version": "1.0.0",
  "description": "Shows the active page IP, ISP, country, and load time.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://cloudflare-dns.com/*",
    "https://ipwho.is/*",
    "https://flagcdn.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Info"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
